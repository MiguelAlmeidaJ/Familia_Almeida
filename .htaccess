DirectoryIndex index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # URLs canônicas sem .php
    RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ / [R=302,L,NE]

    RewriteCond %{THE_REQUEST} \s/+login\.php(?:[?\s]) [NC]
    RewriteRule ^login\.php$ /login [R=302,L,NE]

    RewriteCond %{THE_REQUEST} \s/+install\.php(?:[?\s]) [NC]
    RewriteRule ^install\.php$ /instalar [R=302,L,NE]

    # Arquivos internos e privados nunca são endpoints públicos.
    RewriteRule ^(?:tests|database|includes|scripts|vendor|storage|docs|\.github|\.git)/ - [F,L,NC]

    # Funcionalidades removidas do Bemora: bloquear URL amigável e PHP direto.
    RewriteRule ^(?:cartoes|cartoes/acao|estoque|compras/offline|api/compras/sincronizar|metas|dividas)/?$ - [G,L,NC]
    RewriteRule ^(?:credit_card_action|shopping_sync)\.php$ - [G,L,NC]
    RewriteRule ^pages/(?:cartoes|estoque|compras|compras_mercado|metas|dividas)\.php$ - [G,L,NC]

    RewriteRule ^termos/?$ legal.php [L,QSA,E=LEGAL_DOCUMENT:terms]
    RewriteRule ^privacidade/?$ legal.php [L,QSA,E=LEGAL_DOCUMENT:privacy]
    RewriteRule ^meus-dados/?$ pages/meus_dados.php [L,QSA]
    RewriteRule ^admin/privacidade/?$ admin/privacidade.php [L,QSA]
    RewriteRule ^admin/privacidade/acao/?$ admin/privacy_action.php [L,QSA]

    # Rotas amigáveis
    RewriteRule ^painel/?$ pages/painel.php [L,QSA]
    RewriteRule ^checkout/?$ checkout.php [L,QSA]
    RewriteRule ^pagamento/?$ payment.php [L,QSA]
    RewriteRule ^suporte/relatar/?$ support_action.php [L,QSA]
    RewriteRule ^checkout/cupom/?$ coupon_quote.php [L,QSA]
    RewriteRule ^checkout/iniciar/?$ checkout_action.php [L,QSA]
    RewriteRule ^checkout/aguardando/?$ checkout_status.php [L,QSA]
    RewriteRule ^api/asaas/webhook/?$ asaas_webhook.php [L,QSA]
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^instalar/?$ install.php [L,QSA]
    RewriteRule ^acao/?$ action.php [L,QSA]
    RewriteRule ^sair/?$ logout.php [L,QSA]
    RewriteRule ^comprovante/?$ receipt.php [L,QSA]
    RewriteRule ^movimentacoes/?$ pages/movimentacoes.php [L,QSA]
    RewriteRule ^categorias/?$ pages/categorias.php [L,QSA]
    RewriteRule ^categorias/acao/?$ categories_action.php [L,QSA]
    RewriteRule ^compras/?$ pages/market_lists.php [L,QSA]
    RewriteRule ^compras/mercado/?$ pages/market_lists.php?modo=mercado [L,QSA]
    RewriteRule ^compras/acao/?$ market_action.php [L,QSA]
    RewriteRule ^estoque/?$ pages/estoque.php [L,QSA]
    RewriteRule ^compras/mercado/?$ pages/compras_mercado.php [L,QSA]
    RewriteRule ^compras/offline/?$ compras-offline.html [L]
    RewriteRule ^api/compras/sincronizar/?$ shopping_sync.php [L,QSA]
    RewriteRule ^contas/?$ pages/contas.php [L,QSA]
    RewriteRule ^cartoes/?$ pages/cartoes.php [L,QSA]
    RewriteRule ^cartoes/acao/?$ credit_card_action.php [L,QSA]
    RewriteRule ^metas/?$ pages/metas.php [L,QSA]
    RewriteRule ^dividas/?$ pages/dividas.php [L,QSA]
    RewriteRule ^configuracoes/?$ pages/configuracoes.php [L,QSA]
    RewriteRule ^relatorios/?$ pages/relatorios.php [L,QSA]
    RewriteRule ^membros/?$ pages/membros.php [L,QSA]
    RewriteRule ^membros/acao/?$ pages/membros_action.php [L,QSA]
    RewriteRule ^membros/foto/?$ pages/member_avatar.php [L,QSA]
    RewriteRule ^meu-perfil/?$ pages/meu_perfil.php [L,QSA]
    RewriteRule ^meu-perfil/acao/?$ pages/profile_action.php [L,QSA]
    RewriteRule ^meu-perfil/foto/?$ pages/profile_avatar.php [L,QSA]
    RewriteRule ^minha-conta/?$ pages/minha_conta.php [L,QSA]
    RewriteRule ^minha-assinatura/?$ pages/minha_assinatura.php [L,QSA]
    RewriteRule ^evoluir-plano/?$ pages/evoluir_plano.php [L,QSA]
    RewriteRule ^evoluir-plano/solicitar/?$ plan_change_action.php [L,QSA]
    RewriteRule ^minha-assinatura/cancelar/?$ cancel_subscription_action.php [L,QSA]
    RewriteRule ^admin/cupons/?$ admin/cupons.php [L,QSA]
    RewriteRule ^admin/assinaturas/?$ admin/assinaturas.php [L,QSA]
    RewriteRule ^admin/suporte/?$ admin/suporte.php [L,QSA]
    RewriteRule ^admin/support_action/?$ admin/support_action.php [L,QSA]
    RewriteRule ^admin/beneficios/acao/?$ admin/beneficios_action.php [L,QSA]
    RewriteRule ^admin/beneficios/?$ admin/beneficios.php [L,QSA]
    RewriteRule ^admin/planos/novo/?$ admin/plano_novo.php [L,QSA]
    RewriteRule ^admin/assinatura/acao/?$ admin/assinatura_action.php [L,QSA]
    RewriteRule ^admin/assinatura/?$ admin/assinatura.php [L,QSA]
    RewriteRule ^admin/planos/?$ admin/planos.php [L,QSA]
    RewriteRule ^admin/tenants/?$ admin/tenants.php [L,QSA]
    RewriteRule ^admin/familia/?$ admin/familia.php [L,QSA]
    RewriteRule ^admin/family_action/?$ admin/family_action.php [L,QSA]
    RewriteRule ^convite-familia/?$ convite-familia.php [L,QSA]
    RewriteRule ^verificar-nome-familia/?$ family_name_check.php [L,QSA]
    RewriteRule ^admin/configuracoes/?$ admin/configuracoes.php [L,QSA]
    RewriteRule ^configuracoes/manutencao/?$ pages/manutencao.php [L,QSA]
</IfModule>

<FilesMatch "(?i)(^\\.env|\\.(?:log|sql|gz|zip|bak|old|ini)$|^config\\.(?:php|example\\.php)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>
